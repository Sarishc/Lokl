{
  "name": "lokl-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/production-preflight.cjs && tsc -b && vite build",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "lint": "oxlint",
    "native:prepare": "npm run build && cap sync",
    "preflight:production": "node scripts/production-preflight.cjs",
    "preview": "vite preview",
    "test:release": "npm exec --yes --package=@playwright/test -- sh -lc 'NODE_PATH=$(dirname $(dirname $(which playwright))) node scripts/release-e2e.cjs'",
    "test:smoke": "npm exec --yes --package=@playwright/test -- sh -lc 'NODE_PATH=$(dirname $(dirname $(which playwright))) node scripts/smoke-e2e.cjs'",
    "version:bump": "node scripts/version-bump.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.4.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
