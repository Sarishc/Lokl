# Copy this file to android/keystore.properties (gitignored, never commit it)
# and fill in real values, OR set the same four names as environment variables
# instead (this is what CI should do — no properties file needed there).
#
# RELEASE_STORE_FILE is resolved relative to the android/ directory.
#
# The release build fails loudly if these are missing — see the signing block
# at the top of android/app/build.gradle and RELEASE.md.

RELEASE_STORE_FILE=release.keystore.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
