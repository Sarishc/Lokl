# App mode. Keep mock for a credential-free local demo.
VITE_APP_MODE=mock

# Supabase project URL and anon key. Required only when VITE_APP_MODE=supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth is configured in Supabase Auth > Providers > Google.
# Do not put the real Google client secret in frontend env files.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Supabase Auth CAPTCHA / Bot and Abuse Protection.
# Enable Auth > Settings > Bot and Abuse Protection in Supabase with the hCaptcha secret,
# then expose only the site key to the browser.
VITE_HCAPTCHA_SITE_KEY=

# Production safety gates. Keep false for local development unless the Edge Functions
# below are deployed and configured.
VITE_REQUIRE_OTP_GUARD=false
VITE_IMAGE_MODERATION_REQUIRED=false

# Enables live map rendering in Explore and listing detail screens.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Edge Function secrets. Set with `supabase secrets set`, not in browser env.
GOOGLE_VISION_API_KEY=

# Firebase Cloud Messaging web app config. Required only for browser push opt-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Supabase Edge Function secrets for the not-yet-wired Razorpay scaffolds.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
